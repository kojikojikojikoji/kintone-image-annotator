{
  "name": "kintone-image-annotator",
  "version": "0.1.0",
  "description": "Annotate images in a kintone attachment field with arrows, shapes, and text, then save the annotated copy back to the same field.",
  "license": "MIT",
  "author": "Koji Miyazawa",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "KP_ENTRY=desktop vite build --watch",
    "build": "npm run build:desktop && npm run build:config",
    "build:desktop": "KP_ENTRY=desktop vite build",
    "build:config": "KP_ENTRY=config vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,css,html}\"",
    "pack": "npm run build && node scripts/pack.mjs"
  },
  "dependencies": {
    "@kintone/rest-api-client": "^5.7.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kintone/dts-gen": "^8.1.1",
    "@kintone/plugin-packer": "^8.1.1",
    "@playwright/test": "^1.47.2",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
